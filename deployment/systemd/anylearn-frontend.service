[Unit]
Description=anyLEARN Frontend Service (Next.js)
After=network.target anylearn-backend.service
Wants=anylearn-backend.service

[Service]
Type=simple
User=anylearn-app
Group=anylearn-app
WorkingDirectory=/opt/anylearn/frontend/current
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/opt/anylearn/frontend/current/.env.production
ExecStart=/usr/bin/node /opt/anylearn/frontend/current/node_modules/.bin/next start -p 3000
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/anylearn/frontend/logs/app.log
StandardError=append:/opt/anylearn/frontend/logs/error.log

# Relaxed security for Node.js (needs write access for .next cache)
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/anylearn/frontend

[Install]
WantedBy=multi-user.target
