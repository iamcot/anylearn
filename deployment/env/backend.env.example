# Database (shared với PHP portal — chỉ thêm user có quyền nếu cần)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/anylearn?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# App URLs
JWT_SECRET=<min-32-chars — generate with: openssl rand -base64 32>
APP_URL=https://anylearn.vn
PAYMENT_CALLBACK_URL=https://anylearn.vn
FRONTEND_URL=https://anylearn.vn

# MeiliSearch (phải match với MEILI_MASTER_KEY trong meilisearch .env)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=<production-key>

# Admin (api_token của user có role='admin' trong DB)
# SELECT api_token FROM users WHERE role='admin' LIMIT 1;
ADMIN_API_TOKEN=

# ── Payment gateways (production) ──────────────────────────────────────────

VNPAY_SERVER=https://pay.vnpay.vn/vpcpay/vpcpay.op
VNPAY_TMN_CODE=
VNPAY_SECRET=

ONEPAY_SERVER=https://onepay.vn/paygate/vpcpay.op
ONEPAY_ACCESS_CODE=
ONEPAY_MERCHANT=
ONEPAY_SECRET=

ONEPAYTG_SERVER=https://onepay.vn/vpcpay/vpcpay.op
ONEPAYTG_ACCESS_CODE=
ONEPAYTG_MERCHANT=
ONEPAYTG_SECRET=

MOMO_SERVER=https://payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ── Bank transfer ───────────────────────────────────────────────────────────

BANK_NAME=MB Bank
BANK_BIN=970422
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_TRANSFER_CONTENT=[Họ tên] + [Số điện thoại]
BANK_ZALO_PHONE=

# SePay webhook (POST /v2/payment-notify/sepay): key set in my.sepay.vn, sent as "Authorization: Apikey <key>"
SEPAY_API_KEY=

# ── AWS S3 ──────────────────────────────────────────────────────────────────

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_CDN_URL=

# ── Zalo ZNS (OTP & notifications) ─────────────────────────────────────────
# Lấy từ https://developers.zalo.me → app của bạn
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=https://anylearn.vn/v2/admin/zns/callback
ZALO_CODE_CHALLENGE=vwIliF0AjbWFu4lV4g0fciDAI8OUie7tx2nM06_jdd8
ZALO_CODE_VERIFIER=anylearn
ZALO_OTP_TEMPLATE_ID=275670
# true = development mode (gửi ZNS test, không tính phí), false = production
ZALO_ZNS_TEST_MODE=false
# Shared key for partner apps (11 On Field) calling POST /v2/api/open/zns/otp; empty disables it
ZNS_PARTNER_API_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# MAIL_ENABLED=false → chỉ log console (local dev)
# MAIL_ENABLED=true  → gửi thật qua SMTP (production)
MAIL_ENABLED=true
MAIL_HOST=mail9051.maychuemail.com
MAIL_PORT=465
MAIL_USERNAME=info@anylearn.vn
MAIL_PASSWORD=
MAIL_FROM=info@anylearn.vn
# Extra addresses that get admin emails (comma separated). Empty = none.
ADMIN_EMAIL_RECIPIENTS=

# ── Web Push (PWA notifications) ─────────────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys. Keep the private key secret and never change the pair
# afterwards (every subscribed phone would stop receiving until it opens the site again). Empty = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@anylearn.vn

# Google Maps (Places API New): address search for partner branches. Restrict the key to the server IP. Empty = off.
GOOGLE_MAPS_API_KEY=

# Bunny Stream: video upload for Khám phá (the browser sends the clip straight to Bunny). Leave all three empty = off, admins paste a link.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
# Video courses (plan 17): a second Bunny Stream library with Token Authentication on; empty = the library above, unsigned
BUNNY_COURSE_LIBRARY_ID=
BUNNY_COURSE_API_KEY=
BUNNY_COURSE_CDN_HOST=
BUNNY_COURSE_TOKEN_KEY=

# Anthropic API key (Claude Haiku) for the AI course suggestions. Empty = AI off, suggestions use the rules only.
ANTHROPIC_API_KEY=
