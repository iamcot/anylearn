@baseUrl = {{$dotenv BE_BASE_URL}}/api
@apiToken = {{$dotenv API_TOKEN}}
@jwtToken = {{$dotenv JWT_TOKEN}}

### Get my profile (api_token)
GET {{baseUrl}}/user?api_token={{apiToken}}

### Get my profile (JWT)
GET {{baseUrl}}/user
Authorization: Bearer {{jwtToken}}

### Get public user profile
GET {{baseUrl}}/user/profile/1

### Get users by role
GET {{baseUrl}}/users/school

### Edit profile
POST {{baseUrl}}/user/edit?api_token={{apiToken}}
Content-Type: application/json

{
  "name": "New Name",
  "introduce": "About me"
}

### My calendar
GET {{baseUrl}}/user/mycalendar?api_token={{apiToken}}

### Get notifications
GET {{baseUrl}}/user/notification?api_token={{apiToken}}

### Mark notification read
GET {{baseUrl}}/user/notification/1?api_token={{apiToken}}

### Get documents
GET {{baseUrl}}/user/get-docs?api_token={{apiToken}}

### Pending orders
GET {{baseUrl}}/user/pending-orders?api_token={{apiToken}}

### List children accounts
GET {{baseUrl}}/user/children?api_token={{apiToken}}

### Add a child with only the birth year (dob = January 1st, dobYearOnly = true; checkout asks the full date)
POST {{baseUrl}}/user/children
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{ "name": "Bin", "dob": "2015-01-01", "dobYearOnly": true }

### Give a child the full date of birth (clears dobYearOnly)
POST {{baseUrl}}/user/children
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{ "id": 123, "name": "Bin", "dob": "2015-03-02", "dobYearOnly": false }

### Own date of birth (the account owner as learner)
POST {{baseUrl}}/user/edit
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{ "dob": "1988-05-20" }

### Change password
POST {{baseUrl}}/user/changepass?api_token={{apiToken}}
Content-Type: application/json

{
  "old_password": "oldpass",
  "new_password": "newpass"
}

### Delete account
GET {{baseUrl}}/user/delete?api_token={{apiToken}}
